{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurolab.neuropsicolocos.com/schemas/simulab-psp-scenario-0.1.json",
  "title": "Simu-LAB PSP teaching scenario configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "seed": { "type": ["integer", "string"] },
    "title": { "type": "string", "minLength": 1 },
    "sampleRateHz": { "type": "number", "exclusiveMinimum": 0 },
    "durationMs": { "type": "number", "exclusiveMinimum": 0 },
    "sweepCount": { "type": "integer", "minimum": 1, "maximum": 200 },
    "baselineMv": { "type": "number" },
    "noiseStdMv": { "type": "number", "minimum": 0 },
    "driftMvPerSecond": { "type": "number" },
    "physiologicalLabel": {
      "enum": ["PSP_unclassified", "EPSP", "IPSP"],
      "default": "PSP_unclassified"
    },
    "physiologicalEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "stimuli": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "number", "minimum": 0 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["timeMs"],
            "properties": {
              "id": { "type": "string" },
              "timeMs": { "type": "number", "minimum": 0 },
              "amplitudeScale": { "type": "number", "default": 1 }
            }
          }
        ]
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["monophasic", "biphasic", "none"] },
        "amplitudeMv": { "type": "number" },
        "latencyMs": { "type": "number", "minimum": 0 },
        "tauRiseMs": { "type": "number", "exclusiveMinimum": 0 },
        "tauDecayMs": { "type": "number", "exclusiveMinimum": 0 },
        "secondaryAmplitudeMv": { "type": "number" },
        "secondaryDelayMs": { "type": "number", "minimum": 0 },
        "secondaryTauRiseMs": { "type": "number", "exclusiveMinimum": 0 },
        "secondaryTauDecayMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "variability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amplitudeCv": { "type": "number", "minimum": 0 },
        "latencyJitterMs": { "type": "number", "minimum": 0 },
        "baselineJitterMv": { "type": "number", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amplitudeMv": { "type": "number" },
        "tauMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumMv": { "type": ["number", "null"] },
        "maximumMv": { "type": ["number", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["physiologicalLabel"],
        "properties": {
          "physiologicalLabel": { "enum": ["EPSP", "IPSP"] }
        }
      },
      "then": {
        "required": ["physiologicalEvidence"],
        "properties": {
          "physiologicalEvidence": { "minItems": 1 }
        }
      }
    }
  ]
}
